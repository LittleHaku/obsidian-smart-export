{
	"name": "smart-export",
	"version": "1.2.6",
	"description": "Plugin that exports linked notes by following wikilinks to a configurable depth, optimized for human-readable and LLM-friendly outputs.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"format": "prettier --write '**/*.{js,ts,tsx,md}'",
		"format:check": "prettier --check '**/*.{js,ts,tsx,md}'",
		"test": "vitest --coverage",
		"benchmark": "vitest run --config vitest.benchmark.config.ts"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"llm",
		"export",
		"ai",
		"notes"
	],
	"author": "Iván Sotillo",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@eslint/json": "^0.14.0",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.51.0",
		"@typescript-eslint/parser": "^8.51.0",
		"@vitest/coverage-v8": "^3.2.4",
		"esbuild": "0.25.0",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "^0.1.9",
		"jsdom": "^26.1.0",
		"obsidian": "latest",
		"prettier": "^3.5.3",
		"tslib": "2.4.0",
		"typescript-eslint": "^8.51.0",
		"typescript": "^5.7.2",
		"vitest": "^3.2.4"
	}
}
