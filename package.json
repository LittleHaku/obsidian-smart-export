{
	"name": "smart-export",
	"version": "1.16.1",
	"description": "Plugin that exports linked notes by following wikilinks to a configurable depth, optimized for human-readable and LLM-friendly outputs.",
	"main": "main.js",
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=22 <27",
		"pnpm": ">=11 <12"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "pnpm run typecheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"format": "prettier --write '**/*.{js,ts,tsx,md}'",
		"format:check": "prettier --check '**/*.{js,ts,tsx,md}'",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "vitest run --coverage",
		"check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
		"benchmark": "vitest run --config vitest.benchmark.config.ts"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"llm",
		"export",
		"ai",
		"notes"
	],
	"author": "Iván Sotillo",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^24.13.3",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@vitest/coverage-v8": "^3.2.7",
		"esbuild": "0.25.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"jsdom": "^26.1.0",
		"obsidian": "1.13.1",
		"prettier": "^3.9.6",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"vitest": "^3.2.7"
	}
}
