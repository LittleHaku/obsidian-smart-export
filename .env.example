# Optional local-only development target for WSL/Linux repos.
# When set, `pnpm dev` and `pnpm build` still emit local artifacts as usual,
# and also mirror `main.js`, `manifest.json`, and `styles.css` to this plugin dir.
OBSIDIAN_PLUGIN_DIR=/mnt/c/Users/your-user/path/to/vault/.obsidian/plugins/smart-export
